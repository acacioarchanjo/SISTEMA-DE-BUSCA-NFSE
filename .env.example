# ============================================
# robo-nfse-nacional — configuração (copie para .env)
# ============================================
# Copie este arquivo para `.env` e preencha. O `.env` NÃO vai pro Git (.gitignore).

# ============================================
# AMBIENTE
# ============================================
# producao | homologacao (produção restrita — só para testes de ADN/SEFIN;
# o portal www.nfse.gov.br só tem produção)
NFSE_DEFAULT_AMBIENTE=producao

# ============================================
# PORTAL NACIONAL (endpoints públicos oficiais)
# ============================================
NFSE_PORTAL_HOST=www.nfse.gov.br
NFSE_PORTAL_BASE_PATH=/EmissorNacional

# ADN — Ambiente de Dados Nacional (distribuição de NFS-e por NSU) — é o que o robô usa
NFSE_ADN_HOST_PROD=adn.nfse.gov.br
NFSE_ADN_HOST_HOMOLOG=adn.producaorestrita.nfse.gov.br
NFSE_ADN_BASE_PATH=/contribuintes
# pausa entre lotes (ms), máx. de lotes por execução e trava após consumo indevido (min)
NFSE_ADN_INTERVALO_MS=1500
NFSE_ADN_MAX_LOTES=500
NFSE_ADN_TRAVA_MIN=60

# API REST oficial (consulta de NFS-e por chave — usada na conciliação)
NFSE_API_HOST_SEFIN_PROD=sefin.nfse.gov.br
NFSE_API_HOST_SEFIN_HOMOLOG=sefin.producaorestrita.nfse.gov.br
NFSE_API_SEFIN_BASE_PATH=/SefinNacional

# ============================================
# CRIPTOGRAFIA (CRÍTICO - LGPD)
# ============================================
# Os certificados A1 (.pfx) são cifrados em disco com esta chave (AES-256-GCM).
# Gere uma chave aleatória de 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde em local SEGURO fora do projeto. Se perder, não descriptografa os certificados.
NFSE_MASTER_KEY=COLE_AQUI_UMA_CHAVE_DE_32_BYTES_EM_BASE64

# ============================================
# SERVIDOR LOCAL
# ============================================
NFSE_SERVER_HOST=127.0.0.1
NFSE_SERVER_PORT=3000

# ============================================
# AGENDADOR (opcional — funciona com `npm start` ou `npm run cli -- agendar`)
# ============================================
# Busca diária no ADN (todas as empresas ativas). Deixe vazio para desligar.
NFSE_ADN_CRON=0 3 * * *
# Conciliação mensal com o portal (mês anterior, EXPERIMENTAL). Vazio = desligado.
NFSE_SCHEDULE_CRON=

# ============================================
# CAMINHOS
# ============================================
NFSE_DATA_DIR=./data
NFSE_DB_PATH=./data/nfse-robo.db

# ============================================
# DEBUG (opcional)
# ============================================
# NFSE_DEBUG=1
